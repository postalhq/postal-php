{
    "name": "postal-so/postal-php",
    "description": "SDK oficial do Postal para PHP: envio de e-mails, contatos, eventos, verificação de webhooks e transporte de e-mail para o Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["postal", "email", "e-mail", "transacional", "sdk", "laravel", "webhooks"],
    "homepage": "https://postal.so/docs/sdks",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "symfony/mailer": "Necessário para o transporte de e-mail do Laravel (MAIL_MAILER=postal). Já vem com o Laravel."
    },
    "autoload": {
        "psr-4": {
            "Postal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Postal\\Laravel\\PostalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
