{
    "name": "postal-so/postal-php",
    "description": "Official Postal SDK for PHP: send emails, manage contacts, track events, verify webhooks and a mail transport for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["postal", "email", "e-mail", "transactional", "transacional", "sdk", "laravel", "webhooks"],
    "homepage": "https://postal.so/docs/sdks",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "laravel/framework": "^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "symfony/mailer": "Required for the Laravel mail transport (MAIL_MAILER=postal). It already comes with Laravel."
    },
    "autoload": {
        "psr-4": {
            "Postal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Postal\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Postal\\Laravel\\PostalServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
